# Copy to .env and fill in your own values before running docker compose.
# .env is gitignored — never commit it.

# Secret used to sign JWTs. Use a long random string (32+ chars).
JWT_KEY=

# Initial admin account seeded on first run.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: enables the Stripe payment provider at checkout (see README).
# STRIPE_SECRET_KEY=
